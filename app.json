{
  "expo": {
    "name": "Doc Pawi",
    "slug": "doc-pawi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "docpawi",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.docpawi.app"
    },
    "android": {
      "package": "com.docpawi.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E9F3E1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F8EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": false
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#589039"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Doc Pawi uses the camera to photograph medical documents. Photos are encrypted and stay on this device.",
          "photosPermission": "Doc Pawi imports medical document photos you choose. They are encrypted and stay on this device.",
          "microphonePermission": false
        }
      ],
      "./plugins/withShortCxxPaths"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e739da8-cf38-42a0-849b-c34d76150b35"
      }
    },
    "owner": "jordanfaciols-team"
  }
}
