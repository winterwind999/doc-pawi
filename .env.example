# Doc Pawi build-time configuration (copy to .env.local and adjust). No secrets are required.
# EXPO_PUBLIC_* values are embedded in the app bundle, so never put secrets here.

# Enable "Continue with Google" only after creating an Android OAuth client in Google Cloud for
# package com.docpawi.app with the SHA-1 of the signing key used for this build.
EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# Optional: a Web OAuth client ID (only needed if you want an idToken; Doc Pawi does not use one).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Windows only: number of parallel C++ compile jobs for the native build (default 2).
# DOC_PAWI_CXX_JOBS=2
